  DEFERRABLE INITIALLY DEFERRED
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event_commit"();"
,
      
"ALTER TABLE "repeater_item"
  ADD "title" text NOT NULL;"
,
      
"ALTER TABLE "repeater_item"
  ADD "order" integer;"
,
