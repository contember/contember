  "sql": [
    [
      "CREATE DOMAIN "BoardTaskStatus" AS text CONSTRAINT "boardtaskstatus_check" CHECK (VALUE IN('backlog','todo','inProgress','done'));",
      
"CREATE TABLE "board_tag" (
  "id" uuid PRIMARY KEY NOT NULL
);
CREATE TRIGGER "log_event"
  AFTER INSERT OR UPDATE OR DELETE ON "board_tag"
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event"($pga$id$pga$);
CREATE CONSTRAINT TRIGGER "log_event_trx"
  AFTER INSERT OR UPDATE OR DELETE ON "board_tag"
  DEFERRABLE INITIALLY DEFERRED
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event_commit"();"
,
      
"CREATE TABLE "board_task" (
  "id" uuid PRIMARY KEY NOT NULL
);
CREATE TRIGGER "log_event"
  AFTER INSERT OR UPDATE OR DELETE ON "board_task"
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event"($pga$id$pga$);
CREATE CONSTRAINT TRIGGER "log_event_trx"
  AFTER INSERT OR UPDATE OR DELETE ON "board_task"
  DEFERRABLE INITIALLY DEFERRED
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event_commit"();"
,
      
"CREATE TABLE "board_user" (
  "id" uuid PRIMARY KEY NOT NULL
);
CREATE TRIGGER "log_event"
  AFTER INSERT OR UPDATE OR DELETE ON "board_user"
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event"($pga$id$pga$);
CREATE CONSTRAINT TRIGGER "log_event_trx"
  AFTER INSERT OR UPDATE OR DELETE ON "board_user"
  DEFERRABLE INITIALLY DEFERRED
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event_commit"();"
,
      
"ALTER TABLE "board_tag"
  ADD "name" text NOT NULL;"
,
      
"ALTER TABLE "board_tag"
  ADD "color" text;"
,
      
"ALTER TABLE "board_tag"
  ADD "slug" text NOT NULL;"
,
      
"ALTER TABLE "board_task"
  ADD "title" text NOT NULL;"
,
      
"ALTER TABLE "board_task"
  ADD "description" text;"
,
      
"ALTER TABLE "board_task"
  ADD "status" "BoardTaskStatus";"
,
      
"ALTER TABLE "board_user"
  ADD "name" text NOT NULL;"
,
      
"ALTER TABLE "board_user"
  ADD "username" text NOT NULL;"
,
      
"ALTER TABLE "board_task"
  ADD "assignee_id" uuid;
ALTER TABLE "board_task"
		ADD FOREIGN KEY ("assignee_id") 
		REFERENCES "board_user"("id") ON DELETE SET NULL DEFERRABLE INITIALLY IMMEDIATE;
CREATE INDEX ON "board_task" ("assignee_id");"
,
      
"CREATE TABLE "board_task_tags" (
  "board_task_id" uuid NOT NULL REFERENCES "board_task"("id") ON DELETE CASCADE,
  "board_tag_id" uuid NOT NULL REFERENCES "board_tag"("id") ON DELETE CASCADE
);
ALTER TABLE "board_task_tags" ADD PRIMARY KEY ("board_task_id", "board_tag_id");
CREATE TRIGGER "log_event"
  AFTER INSERT OR UPDATE OR DELETE ON "board_task_tags"
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event"($pga$board_task_id$pga$, $pga$board_tag_id$pga$);
CREATE CONSTRAINT TRIGGER "log_event_trx"
  AFTER INSERT OR UPDATE OR DELETE ON "board_task_tags"
  DEFERRABLE INITIALLY DEFERRED
  FOR EACH ROW
  EXECUTE PROCEDURE "system"."trigger_event_commit"();"
,
      "ALTER TABLE "board_tag" ADD UNIQUE ("slug");",
      "ALTER TABLE "board_user" ADD UNIQUE ("username");",
      
"ALTER TABLE "board_task"
  ADD "order" integer;"
,
      
"ALTER TABLE "board_user"
  ADD "order" integer;"
,
      
"CREATE TABLE "repeater_item" (
