"CREATE VIEW "grid_article_detail" AS 
	SELECT
		article.id AS id,
		article.id AS article_id,
		(SELECT COUNT(*)
		 FROM "grid_article_comment" comment
		 WHERE comment.article_id = article.id) AS comments_count
	FROM "grid_article" article;
;"
